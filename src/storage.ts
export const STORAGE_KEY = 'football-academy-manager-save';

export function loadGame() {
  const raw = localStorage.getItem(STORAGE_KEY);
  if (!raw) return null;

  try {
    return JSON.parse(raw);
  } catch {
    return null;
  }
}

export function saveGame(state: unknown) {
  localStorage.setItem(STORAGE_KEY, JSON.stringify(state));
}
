export function buildStartingState(clubName: string): GameState {
  const players = INITIAL_PLAYERS.map((player, idx) => ({
    ...player,
    id: idx + 1
  }));

  const rivals: Rival[] = RIVAL_NAMES.map((name, index) => ({
    id: index + 1,
    name,
    strength: 58 + index * 5,
    style: index % 2 === 0 ? 'Presión alta' : 'Contraataque'
  }));

  return {
    clubName,
    day: 1,
    money: 1850,
    reputation: 1,
    stadiumCapacity: 400,
    matchHistory: [],
    players,
    rivals,
    buildings: {
      trainingGround: 1,
      stadium: 1,
      gym: 1,
      medical: 1,
      youthAcademy: 1,
      residence: 1,
      admin: 1,
      tacticalCenter: 1,
      shop: 1,
      commercial: 1
    },
    missions: defaultMissions(),
    logs: ['Academia creada con éxito. El proyecto ya está en marcha.']
  };
}

export function getBuildingUpgradeCost(buildingKey: string, level: number): number {
  const config = BUILDINGS[buildingKey];
  if (!config) return 0;
  return Math.round(config.baseCost * Math.pow(1.7, level - 1));
}

export function getClubAverageRating(players: Player[]): number {
  return Math.round(players.reduce((sum, player) => sum + player.rating, 0) / players.length);
}

export function getPlayerOverall(player: Player): number {
  return Math.round(
    (player.pace +
      player.stamina +
      player.strength +
      player.passing +
      player.dribbling +
      player.shooting +
      player.defense +
      player.tactics) /
      8
  );
}

export function calculateIncome(state: GameState): number {
  const buildingBonus = Object.entries(state.buildings).reduce((total, [key, value]) => {
    const building = BUILDINGS[key];
    return total + (building ? building.income * value : 0);
  }, 0);

  const base = 280 + buildingBonus + state.reputation * 25;
  return Math.round(base - state.players.reduce((total, player) => total + player.salary / 8, 0));
}

export function nextDayState(state: GameState): GameState {
  const newState = JSON.parse(JSON.stringify(state)) as GameState;
  newState.day += 1;
  newState.money += calculateIncome(newState);

  newState.players = newState.players.map((player) => {
    const fitnessDelta = player.injured > 0 ? -8 : -3;
    const nextFitness = Math.max(40, Math.min(100, player.fitness + fitnessDelta));
    const nextMorale = Math.max(50, Math.min(100, player.morale + 2));

    const nextPlayer = {
      ...player,
      fitness: nextFitness,
      morale: nextMorale,
      injured: Math.max(0, player.injured - 1)
    };

    nextPlayer.rating = getPlayerOverall(nextPlayer);
    return nextPlayer;
  });

  newState.logs = [`Día ${newState.day}: ingresos del club actualizados.`, ...newState.logs].slice(0, 8);
  return updateMissionProgress(newState);
}

export function updateMissionProgress(state: GameState): GameState {
  const nextState = JSON.parse(JSON.stringify(state)) as GameState;
  const avgRating = getClubAverageRating(nextState.players);

  nextState.missions = nextState.missions.map((mission) => {
    let progress = mission.progress;
    switch (mission.type) {
      case 'wins':
        progress = nextState.matchHistory.filter((match) => match.result === 'W').length;
        break;
      case 'money':
        progress = nextState.money;
        break;
      case 'rating':
        progress = avgRating;
        break;
      case 'build':
        progress = nextState.buildings.trainingGround;
        break;
      case 'training':
        const trainingSessions = nextState.logs.filter((log) => log.toLowerCase().includes('entrenamiento')).length;
        progress = trainingSessions;
        break;
      default:
        progress = mission.progress;
    }

    const completed = progress >= mission.goal;
    if (completed && !mission.completed) {
      nextState.money += mission.reward;
      nextState.logs = [`Misión completada: ${mission.title} (+${mission.reward} €)`, ...nextState.logs].slice(0, 8);
    }

    return {
      ...mission,
      progress,
      completed: completed || mission.completed
    };
  });

  return nextState;
}

export function trainPlayers(state: GameState, mode: 'individual' | 'collective'): GameState {
  const nextState = JSON.parse(JSON.stringify(state)) as GameState;
  const cost = mode === 'individual' ? 120 : 180;
  if (nextState.money < cost) {
    nextState.logs = ['No hay dinero suficiente para entrenar.']
    return nextState;
  }

  nextState.money -= cost;
  const selectedPlayers = [...nextState.players].sort((a, b) => b.morale - a.morale).slice(0, mode === 'individual' ? 2 : 3);

  selectedPlayers.forEach((player) => {
    const boost = mode === 'individual' ? 2 : 1;
    const attrList: Array<keyof Player> = ['pace', 'stamina', 'passing', 'dribbling', 'shooting', 'defense', 'tactics'];
    const attr = attrList[Math.floor(Math.random() * attrList.length)];
    const value = player[attr] as number;
    (player as any)[attr] = Math.min(99, value + boost);
    player.morale = Math.min(100, player.morale + 4);
    player.fitness = Math.min(100, player.fitness + 5);
    player.experience += 2;
    player.rating = getPlayerOverall(player);
  });

  nextState.logs = [`Entrenamiento ${mode === 'individual' ? 'individual' : 'colectivo'} realizado.`, ...nextState.logs].slice(0, 8);
  return updateMissionProgress(nextState);
}

export function upgradeBuilding(state: GameState, key: string): GameState {
  const nextState = JSON.parse(JSON.stringify(state)) as GameState;
  const currentLevel = nextState.buildings[key] ?? 1;
  const cost = getBuildingUpgradeCost(key, currentLevel + 1);

  if (nextState.money < cost) {
    nextState.logs = ['No hay presupuesto suficiente para mejorar esa instalación.'];
    return nextState;
  }

  nextState.money -= cost;
  nextState.buildings[key] = currentLevel + 1;
  nextState.reputation += 1;
  nextState.stadiumCapacity += key === 'stadium' ? 200 : 0;
  nextState.logs = [`${BUILDINGS[key]?.name || 'Instalación'} mejorada al nivel ${nextState.buildings[key]}.`, ...nextState.logs].slice(0, 8);
  return updateMissionProgress(nextState);
}

export function playFriendly(state: GameState, opponentName: string): GameState {
  const nextState = JSON.parse(JSON.stringify(state)) as GameState;
  const rival = nextState.rivals.find((item) => item.name === opponentName) ?? nextState.rivals[0];
  const teamRating = getClubAverageRating(nextState.players) + nextState.buildings.tacticalCenter * 2 + nextState.buildings.trainingGround;
  const opponentRating = rival.strength;

  const ourGoals = Math.max(0, Math.round((teamRating - opponentRating) / 12 + Math.random() * 2.2 + 0.4));
  const rivalGoals = Math.max(0, Math.round((opponentRating - teamRating) / 14 + Math.random() * 1.8));

  const result: MatchRecord = {
    id: Date.now(),
    opponent: rival.name,
    score: `${ourGoals}-${rivalGoals}`,
    result: ourGoals > rivalGoals ? 'W' : ourGoals < rivalGoals ? 'L' : 'D',
    day: nextState.day
  };

  nextState.matchHistory = [result, ...nextState.matchHistory].slice(0, 10);

  if (result.result === 'W') {
    nextState.money += 550;
    nextState.logs = [`Victoria ante ${rival.name}: ${result.score}.`, ...nextState.logs].slice(0, 8);
  } else if (result.result === 'D') {
    nextState.money += 240;
    nextState.logs = [`Empate frente a ${rival.name}: ${result.score}.`, ...nextState.logs].slice(0, 8);
  } else {
    nextState.money += 120;
    nextState.logs = [`Derrota frente a ${rival.name}: ${result.score}.`, ...nextState.logs].slice(0, 8);
  }

  nextState.players = nextState.players.map((player) => {
    const staminaChange = result.result === 'W' ? 4 : -2;
    return {
      ...player,
      morale: Math.max(50, Math.min(100, player.morale + (result.result === 'W' ? 6 : 1))),
      fitness: Math.max(45, Math.min(100, player.fitness + staminaChange)),
      experience: player.experience + 5
    };
  });

  return updateMissionProgress(nextState);
}
